# Netlify response headers (https://docs.netlify.com/routing/headers/).
#
# Every file under /assets/ carries a fingerprint of its contents in its name,
# so its URL never changes: browsers may keep it for a year without asking
# again. The HTML that points at those files keeps Netlify's default
# (always revalidate), so a new deploy shows up on the next visit.
#
# Render serves the same rule from scripts/asset-cache-plugin.mjs. Keep the
# two in step.
#
# The security headers below come from scripts/security-headers.mjs (Render
# sends them from there). Print them with `node scripts/security-headers.mjs`;
# a test fails if this file drifts. The CSP hash covers the inline theme
# script in index.html, so editing that script means updating this file.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-I0q5BLV0ULdtA9R7F80sUvAX/ACaf/8YMVmrRae/CAY='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.emailjs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
